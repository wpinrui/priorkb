{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PriorKB editorial skill equivalences",
  "type": "object",
  "required": ["groups", "candidateDecisions"],
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "candidateId", "decision", "appearanceIds", "label", "description", "reason"],
        "properties": {
          "id": {"type": "string"},
          "candidateId": {"type": "string"},
          "decision": {"const": "merge"},
          "appearanceIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
          "label": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "candidateDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidateId", "decision", "reason"],
        "properties": {
          "candidateId": {"type": "string"},
          "decision": {"enum": ["merged", "partially-merged", "kept-separate"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
