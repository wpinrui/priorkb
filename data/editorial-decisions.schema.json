{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source objective decomposition decisions",
  "type": "object",
  "required": ["decisions"],
  "additionalProperties": false,
  "properties": {
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["objectiveId", "decision", "reason", "parts"],
      "additionalProperties": false,
      "properties": {
        "objectiveId": {"type": "string", "minLength": 1},
        "decision": {"enum": ["keep", "split", "defer"]},
        "reason": {"type": "string", "minLength": 1},
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}}
      }
    },
    "part": {
      "type": "object",
      "required": ["label", "description", "scopeNotes"],
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "scopeNotes": {"type": "array", "items": {"type": "string"}},
        "role": {"enum": ["syllabus-content", "assumed-knowledge"]}
      }
    }
  }
}
