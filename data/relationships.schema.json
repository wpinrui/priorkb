{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prerequisite relationship vote aggregation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "subject",
    "scope",
    "purpose",
    "packetSha256",
    "knowledgeSha256",
    "voteFiles",
    "voters",
    "summary",
    "entries",
    "skillCoverage"
  ],
  "properties": {
    "formatVersion": {"const": 1},
    "subject": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "packetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "knowledgeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "voteFiles": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
    "voters": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/voter"}},
    "summary": {"$ref": "#/$defs/summary"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "skillCoverage": {"type": "array", "items": {"$ref": "#/$defs/skillCoverage"}}
  },
  "$defs": {
    "voter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voterId", "model", "sessionId", "promptSha256"],
      "properties": {
        "voterId": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "sessionId": {"type": "string", "minLength": 1},
        "promptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateCount", "voterCount", "voteCount", "consensusClassificationCounts", "statusCounts", "cycleEdgeCount", "coverageNote"],
      "properties": {
        "candidateCount": {"type": "integer", "minimum": 0},
        "voterCount": {"type": "integer", "const": 5},
        "voteCount": {"type": "integer", "minimum": 0},
        "consensusClassificationCounts": {"$ref": "#/$defs/classCounts"},
        "finalClassificationCounts": {"$ref": "#/$defs/classCounts"},
        "humanDecisionCount": {"type": "integer", "minimum": 0},
        "statusCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted", "rejected", "needs-decision"],
          "properties": {
            "accepted": {"type": "integer", "minimum": 0},
            "rejected": {"type": "integer", "minimum": 0},
            "needs-decision": {"type": "integer", "minimum": 0}
          }
        },
        "cycleEdgeCount": {"type": "integer", "minimum": 0},
        "coverageNote": {"type": "string", "minLength": 1}
      }
    },
    "classCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["essential", "helpful", "none"],
      "properties": {
        "essential": {"type": "integer", "minimum": 0},
        "helpful": {"type": "integer", "minimum": 0},
        "none": {"type": "integer", "minimum": 0}
      }
    },
    "consensus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "counts", "voteCount"],
      "properties": {
        "classification": {"enum": ["essential", "helpful", "none", null]},
        "counts": {"$ref": "#/$defs/classCounts"},
        "voteCount": {"type": "integer", "const": 5}
      }
    },
    "vote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voterId", "model", "sessionId", "classification", "rationale"],
      "properties": {
        "voterId": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "sessionId": {"type": "string", "minLength": 1},
        "classification": {"enum": ["essential", "helpful", "none"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "humanDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "classification", "decidedBy", "reason", "evidence"],
      "properties": {
        "candidateId": {"type": "string", "minLength": 1},
        "classification": {"enum": ["essential", "helpful", "none"]},
        "decidedBy": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prerequisiteAppearanceId", "dependentAppearanceId"],
      "properties": {
        "prerequisiteAppearanceId": {"type": "string", "minLength": 1},
        "dependentAppearanceId": {"type": "string", "minLength": 1}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prerequisiteSkillId", "dependentSkillId", "direction", "contexts", "candidateReasons", "consensus", "status", "votes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "prerequisiteSkillId": {"type": "string", "minLength": 1},
        "dependentSkillId": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "minLength": 1},
        "contexts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/context"}},
        "candidateReasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "consensus": {"$ref": "#/$defs/consensus"},
        "effectiveClassification": {"enum": ["essential", "helpful", "none", null]},
        "decisionSource": {"enum": ["consensus", "user", null]},
        "humanDecision": {"$ref": "#/$defs/humanDecision"},
        "status": {"enum": ["accepted", "rejected", "needs-decision"]},
        "votes": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/vote"}},
        "reviewFlags": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reviewReason": {"type": "string", "minLength": 1}
      }
    },
    "skillCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "incomingCandidateCount", "status"],
      "properties": {
        "skillId": {"type": "string", "minLength": 1},
        "incomingCandidateCount": {"type": "integer", "minimum": 0},
        "status": {"enum": ["unassessed", "pilot-only"]}
      }
    }
  }
}
