{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human prerequisite relationship decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "packetSha256", "knowledgeSha256", "decisions"],
  "properties": {
    "formatVersion": {"const": 1},
    "packetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "knowledgeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "classification", "decidedBy", "reason", "evidence"],
      "properties": {
        "candidateId": {"type": "string", "minLength": 1},
        "classification": {"enum": ["essential", "helpful", "none"]},
        "decidedBy": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
